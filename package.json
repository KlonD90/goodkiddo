{
  "name": "goodkiddo",
  "version": "0.2.0-prealpha.1",
  "description": "A personal Telegram assistant for requests, reminders, and group meetings.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build ./src/app/telegram-assistant.ts --outfile ./dist/index.js --target bun",
    "build:runners": "bun install --cwd runners/agent-runner && bun run --cwd runners/agent-runner build && bun install --cwd runners/codex-runner && bun run --cwd runners/codex-runner build",
    "build:container": "docker build -f container/Dockerfile -t goodkiddo-reviewer:latest .",
    "build:all": "bun run build",
    "deploy": "bun run build && systemctl --user restart goodkiddo",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/app/telegram-assistant.ts",
    "test": "vitest run",
    "test:analytics": "bun test checks/analytics",
    "typecheck": "tsc --noEmit",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "bun setup/cli/index.ts",
    "build:legacy": "bun build ./src/app/index.ts --outfile ./dist/legacy.js --target bun",
    "dev:legacy": "bun --watch src/app/index.ts",
    "start:legacy": "bun dist/legacy.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "cheerio": "1.2.0",
    "cron-parser": "=5.5.0",
    "csv-parse": "6.2.1",
    "discord.js": "=14.26.0",
    "exceljs": "4.4.0",
    "ipaddr.js": "2.2.0",
    "pdf-parse": "2.4.5",
    "pino": "=9.14.0",
    "pino-pretty": "=13.1.3",
    "posthog-node": "5.54.1",
    "yaml": "=2.8.3",
    "yauzl": "3.2.0",
    "zod": "=4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.10.0",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-v8": "^4.0.18",
    "better-sqlite3": "^12.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
